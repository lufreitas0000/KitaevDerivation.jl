/--
Abstract Idempotency for projection operators.
This avoids computing 15x15 dense matrices by verifying P * P = P algebraically.
-/
class Projector (P : Type) extends Mul P where
  idemp : ∀ p : P, p * p = p

/--
Orthogonality definition for mutually exclusive subspaces (e.g. Singlet vs Triplet).
P_A * P_B = 0
-/
def OrthogonalProjectors {P : Type} [Projector P] [Zero P] (pa pb : P) : Prop :=
  pa * pb = 0

/-- Example theorem scaffolding representing combinatorial discipline -/
theorem singlet_triplet_orthogonal {P : Type} [Projector P] [Zero P] (p_singlet p_triplet : P)
  (h : OrthogonalProjectors p_singlet p_triplet) : p_singlet * p_triplet = 0 := by
  exact h
